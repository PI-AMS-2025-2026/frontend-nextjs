# Copie para `.env` e preencha os valores CHANGE_ME. O `.env` é ignorado pelo Git.
#   cp .env.example .env
#
# Usado APENAS pelo docker-compose.yml de desenvolvimento local.

# --- Banco de dados (local, via compose; sem porta publicada no host) ---
POSTGRES_DB=gini
POSTGRES_USER=gini
# Qualquer valor; gere com: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# --- Backend ---
# A imagem do backend é PRIVADA no ghcr.io. Antes de subir o compose é preciso
# autenticar com um PAT que tenha o escopo `read:packages`:
#   echo "<SEU_PAT>" | docker login ghcr.io -u <seu-usuario-github> --password-stdin
BACKEND_IMAGE=ghcr.io/pi-ams-2025-2026/backend-java
# `dev` acompanha a branch dev do backend; use `sha-<7 chars>` para fixar versão.
BACKEND_TAG=dev
# Porta publicada no host (a interna é sempre 8080).
BACKEND_PORT=8080

# Segredo de assinatura do JWT. O backend EXIGE 32+ caracteres e recusa
# valores de exemplo (não sobe com CHANGE_ME). Gere com: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Swagger UI em http://localhost:8080/swagger-ui.html (só local).
SWAGGER_ENABLED=true

# Interface web do Mailpit (e-mails de recuperação de senha): http://localhost:8025
MAILPIT_WEB_PORT=8025

# --- Frontend ---
# Porta publicada no host. Também define FRONTEND_URL do backend (CORS e link
# do e-mail de recuperação), então acesse o frontend por http://localhost:<porta>.
FRONTEND_PORT=3000
# URL da API embutida no bundle em tempo de build (ver README). Precisa casar
# com BACKEND_PORT.
NEXT_PUBLIC_API_URL=http://localhost:8080
