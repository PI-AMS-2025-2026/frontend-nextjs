# Copie para `.env` e preencha os valores. O `.env` é ignorado pelo Git.
#   cp .env.example .env

# --- Banco de dados (local, via compose) ---
POSTGRES_DB=projeto_integrador
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# --- Backend ---
# A imagem do backend é PRIVADA no ghcr.io. Antes de subir o compose é preciso
# autenticar com um PAT que tenha o escopo `read:packages`:
#   echo "<SEU_PAT>" | docker login ghcr.io -u <seu-usuario-github> --password-stdin
BACKEND_IMAGE=ghcr.io/pi-ams-2025-2026/CHANGE_ME
BACKEND_TAG=dev

# Segredo de assinatura do JWT usado pelo backend (qualquer valor longo em dev).
JWT_SECRET=CHANGE_ME

# --- Frontend ---
# Porta publicada no host.
FRONTEND_PORT=3000
# URL da API embutida no bundle em tempo de build (ver README).
NEXT_PUBLIC_API_URL=http://localhost:8080
